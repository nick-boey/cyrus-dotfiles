{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "spec_conformance", "summary", "provenance", "findings", "next_steps"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["approve", "needs-attention", "inconclusive"]
    },
    "spec_conformance": {
      "type": "string",
      "enum": ["conformant", "non-conformant", "not-evaluated", "inconclusive"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_path", "target", "evidence_completeness"],
      "properties": {
        "reviewer_path": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "evidence_completeness": { "type": "string", "enum": ["complete", "partial"] }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "title", "body", "file", "line_start", "line_end", "confidence", "recommendation"],
        "properties": {
          "id": { "type": "string", "pattern": "^IR-[0-9]+$" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "title": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "line_start": { "type": "integer", "minimum": 1 },
          "line_end": { "type": "integer", "minimum": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "recommendation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "next_steps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
